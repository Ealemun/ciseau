{
  "manifest_version": 3,
  "name": "ciseau",
  "version": "0.1.0",
  "description": "Marque le début et la fin d'un passage pendant que tu regardes la vidéo, puis extrais-le avec ciseau.",
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "action": {
    "default_title": "ciseau",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png"
    }
  },
  "background": {
    "service_worker": "arriere-plan.js"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["contenu.js"],
      "run_at": "document_idle"
    }
  ]
}
